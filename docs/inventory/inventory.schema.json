{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ding-ding-projects.github.io/meadowmark/schemas/completeness-inventory-v2.json",
  "title": "Meadowmark canonical per-surface completeness inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "notes",
    "contracts",
    "surfaces",
    "surfaceRecords"
  ],
  "properties": {
    "$schema": { "const": "./inventory.schema.json" },
    "schemaVersion": { "const": 2 },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "contracts": {
      "type": "array",
      "minItems": 45,
      "maxItems": 45,
      "items": { "$ref": "#/$defs/contract" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": { "$ref": "#/$defs/surface" }
    },
    "surfaceRecords": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": { "$ref": "#/$defs/surfaceRecord" }
    }
  },
  "$defs": {
    "repositoryPathList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^\\\\/].*"
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "endpoint", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "kind": { "enum": ["desktop-app", "site-endpoint"] },
        "endpoint": { "type": ["string", "null"] },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "contractRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "status",
        "implementation",
        "article",
        "localization",
        "tests",
        "persistence",
        "bundledArtifactProof",
        "builtArtifactInteraction",
        "capture"
      ],
      "properties": {
        "contractId": { "type": "string" },
        "status": { "enum": ["missing", "partial", "done"] },
        "implementation": { "$ref": "#/$defs/repositoryPathList" },
        "article": { "$ref": "#/$defs/repositoryPathList" },
        "localization": { "$ref": "#/$defs/repositoryPathList" },
        "tests": { "$ref": "#/$defs/repositoryPathList" },
        "persistence": { "$ref": "#/$defs/repositoryPathList" },
        "bundledArtifactProof": { "$ref": "#/$defs/repositoryPathList" },
        "builtArtifactInteraction": { "$ref": "#/$defs/repositoryPathList" },
        "capture": { "$ref": "#/$defs/repositoryPathList" }
      }
    },
    "surfaceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "contracts"],
      "properties": {
        "surfaceId": { "type": "string" },
        "contracts": {
          "type": "array",
          "minItems": 45,
          "maxItems": 45,
          "items": { "$ref": "#/$defs/contractRecord" }
        }
      }
    }
  },
  "x-status-semantics": {
    "missing": "All evidence arrays are empty. This state blocks release.",
    "partial": "At least one evidence array is populated but one or more evidence classes remain empty. This state blocks release.",
    "done": "Every evidence class is populated with field-appropriate repository-contained regular file blobs at the validated commit."
  },
  "x-evidence-fields": [
    "implementation",
    "article",
    "localization",
    "tests",
    "persistence",
    "bundledArtifactProof",
    "builtArtifactInteraction",
    "capture"
  ]
}
